# ==========================================================================
# PUNJAB PARA SPORTS ASSOCIATION (PPSA) - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or .env.local and populate with your credentials.
# NEVER commit .env or real credentials to source control!
# ==========================================================================

# Database Configuration
DB_HOST=localhost
DB_NAME=ppsa_production
DB_USER=ppsa_user
DB_PASSWORD=

# Transactional Email Gateway (Resend API)
RESEND_API_KEY=
MAILER_FROM=Punjab Para Sports Association <noreply@punjabparasports.org>

# Cryptographic & Security Keys
OTP_SECRET=
APP_ENV=production

# Initial Superadmin Configuration (for deployment seed script)
PPSA_ADMIN_USERNAME=admin
PPSA_ADMIN_EMAIL=admin@punjabparasports.org
PPSA_ADMIN_PASSWORD=
